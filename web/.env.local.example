# All NEXT_PUBLIC_* vars are exposed client-side. Do NOT put secrets here.

# Contract addresses (one per chain)
NEXT_PUBLIC_CONTRACT_ADDRESS_SEPOLIA=0xdcEB5E9A8736cD43641A7fb6fc57dF9D86C8F6A3
NEXT_PUBLIC_CONTRACT_ADDRESS_ARBITRUM_SEPOLIA=0x54d88A4205CCc5bFEF82c47385ce37719eB6884E

# Optional RPC overrides (defaults are public endpoints)
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# WalletConnect (optional) — set this to enable WalletConnect QR pairing
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

